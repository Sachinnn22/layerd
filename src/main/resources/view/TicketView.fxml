<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gdse.AirTicket.controller.TicketController">
   <children>
      <!-- Header Section -->
      <VBox alignment="CENTER" prefHeight="60.0" style="-fx-background-color: #2d3436; -fx-padding: 10;">
         <children>
            <Label alignment="TOP_CENTER" prefHeight="30.0" prefWidth="580.0" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Ticket Management" />
         </children>
      </VBox>

      <!-- Main Content -->
      <VBox layoutY="70.0" prefHeight="430.0" prefWidth="600.0" spacing="20.0" style="-fx-padding: 15; -fx-background-color: #fff;">
         <children>
            <!-- Ticket ID Row -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="150.0" style="-fx-text-fill: #333; -fx-font-size: 14px;" text="Ticket Id" />
                  <Label fx:id="lblTicketId" style="-fx-background-color: #eaf2f8; -fx-padding: 5; -fx-border-color: #d6eaf8; -fx-border-radius: 5; -fx-background-radius: 5;" text="1" />
               </children>
            </HBox>

            <!-- Destination ID and Plane ID Row -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="150.0" style="-fx-text-fill: #333; -fx-font-size: 14px;" text="Destination Id" />
                  <ComboBox fx:id="comboDestinationId" prefHeight="26.0" prefWidth="159.0" promptText="Select Destination Id" style="-fx-background-color: #ffffff; -fx-border-color: #7367F0; -fx-border-width: 0 0 1px 0;" />
                  <Label prefHeight="20.0" prefWidth="94.0" style="-fx-text-fill: #333; -fx-font-size: 14px;" text="Plane Id" />
                  <ComboBox fx:id="comboPlaneId" prefWidth="150.0" promptText="Select Plane Id" style="-fx-background-color: #ffffff; -fx-border-color: #7367F0; -fx-border-width: 0 0 1px 0;" />
               </children>
            </HBox>

            <!-- Class Row -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="150.0" style="-fx-text-fill: #333; -fx-font-size: 14px;" text="Class" />
                  <ComboBox fx:id="comboClass" prefWidth="150.0" promptText="Select Class" style="-fx-background-color: #ffffff; -fx-border-color: #7367F0; -fx-border-width: 0 0 1px 0;" />
               </children>
            </HBox>

            <!-- Ticket Cost Row -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="150.0" style="-fx-text-fill: #333; -fx-font-size: 14px;" text="Ticket Cost" />
                  <TextField fx:id="txtTicketCost" promptText="Enter Ticket Cost" style="-fx-background-color: #fff; -fx-border-color: #7367F0; -fx-border-width: 0 0 1px 0;" />
               </children>
            </HBox>

            <!-- Buttons Row -->
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button fx:id="btnReset" onAction="#btnResetOnAction" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5;" text="Reset" />
                  <Button fx:id="btnDelete" onAction="#btnDeleteOnAcction" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-background-radius: 5;" text="Delete" />
                  <Button fx:id="btnUpdate" onAction="#btnUpdateOnAcction" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5;" text="Update" />
                  <Button fx:id="btnSave" onAction="#btnSaveOnAcction" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 5;" text="Save" />
               </children>
            </HBox>

            <!-- Table View -->
            <TableView fx:id="tblTickets" onMouseClicked="#onClickTable" style="-fx-border-color: #ddd;" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colTicketId" prefWidth="91.0" text="Ticket Id" />
                  <TableColumn fx:id="colDestinationId" prefWidth="112.0" text="Destination Id" />
                  <TableColumn fx:id="colPlaneId" prefWidth="119.0" text="Plane Id" />
                  <TableColumn fx:id="colTicketClass" prefWidth="124.0" text="Class" />
                  <TableColumn fx:id="colTicketCost" prefWidth="122.0" text="Ticket Cost" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
